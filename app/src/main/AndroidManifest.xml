    <uses-permission android:name="android.permission.INTERNET" />
    <application android:theme="@style/Theme.XSportsX" android:label="XSportsX" android:usesCleartextTraffic="false" android:resizeableActivity="true">
        <activity android:name=".MainActivityFuture" android:screenOrientation="unspecified" android:exported="true">
